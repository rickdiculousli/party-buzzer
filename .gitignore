node_modules/
dist/
state.json
packs/.cache/

# Downloads waiting to be auditioned. Deliberately messy and deliberately not
# in the repo — what survives gets adopted into client/public/sounds.
sounds/raw/

# Synthesized stand-ins from `npm run demo-sounds`, so the Library and the
# + layer picker have something to pick from. Throwaway by construction — a
# recipe that names one plays here and nowhere else.
client/public/sounds/demo-*

# Built by swiftc at server boot from server/stt/stt.swift — a machine binary,
# not a source artifact.
server/stt/stt

# The local-ip.sh wildcard, cached at boot and refetched near expiry. Public
# key material by design, but it turns over every 90 days — checking it in
# would just be committing something guaranteed to go stale.
.cert/

# Isolated workspaces and agent scratch. Neither belongs in the repo.
.worktrees/
.superpowers/
