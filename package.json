{
  "name": "party-buzzer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.ts",
    "dev": "vite",
    "build": "vite build",
    "sim": "node tools/sim.ts",
    "probe": "node tools/probe.ts",
    "motion": "vite --open /anim.html",
    "anim": "node tools/probe.ts loop join:Ada,Bo,Cy,Dee value:400 arm buzz:Ada@1000,Bo@1250,Cy@1500,Dee@1750 wait:2000 correct wait:2000 next wait:1000",
    "test": "node --test 'server/*.test.ts' 'server/modes/*.test.ts' 'client/*.test.ts' 'shared/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "fakes": "node tools/fakes.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "preact": "^10.26.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
